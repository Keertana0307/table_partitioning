CREATE TABLE sales_range (
    Region VARCHAR(50),
    Country VARCHAR(50),
    Item_Type VARCHAR(50),
    Sales_Channel VARCHAR(20),
    Order_Priority CHAR(1),
    Order_Date DATE,
    Order_ID BIGINT,
    Ship_Date DATE,
    Units_Sold INT,
    Unit_Price DECIMAL(10,2),
    Unit_Cost DECIMAL(10,2),
    Total_Revenue DECIMAL(15,2),
    Total_Cost DECIMAL(15,2),
    Total_Profit DECIMAL(15,2),
    PRIMARY KEY (Order_ID, Order_Date)
)
PARTITION BY RANGE (YEAR(Order_Date)) (
    PARTITION p_before_2013 VALUES LESS THAN (2013),
    PARTITION p_2013 VALUES LESS THAN (2014),
    PARTITION p_2014 VALUES LESS THAN (2015),
    PARTITION p_2015 VALUES LESS THAN (2016),
    PARTITION p_2016 VALUES LESS THAN (2017),
    PARTITION p_2017 VALUES LESS THAN (2018),
    PARTITION p_2018 VALUES LESS THAN (2019),
    PARTITION p_future VALUES LESS THAN MAXVALUE
);
INSERT INTO sales_range
SELECT * FROM sales_source;
SELECT
    PARTITION_NAME,
    TABLE_ROWS
FROM INFORMATION_SCHEMA.PARTITIONS
WHERE TABLE_NAME = 'sales_range';
EXPLAIN ANALYZE
SELECT *
FROM sales_range
