-- Scalability
-- Initialize total times
SET @total_time_small = 0;
SET @total_time_medium = 0;
SET @total_time_large = 0;
 
-- Small dataset
SET @start = UNIX_TIMESTAMP(NOW(6));
SELECT COUNT(*) 
FROM database_sales.sales
WHERE Country = 'Canada'
    AND Ship_Date BETWEEN '2022-01-01' AND '2022-01-07';
SET @end = UNIX_TIMESTAMP(NOW(6));
SET @total_time_small = @end - @start;
 
-- Medium dataset
SET @start = UNIX_TIMESTAMP(NOW(6));
SELECT COUNT(*) 
FROM database_sales.sales
WHERE Country = 'Canada'
    AND Ship_Date BETWEEN '2022-01-01' AND '2022-01-07';
SET @end = UNIX_TIMESTAMP(NOW(6));
SET @total_time_medium = @end - @start;
 
-- Large dataset
SET @start = UNIX_TIMESTAMP(NOW(6));
SELECT COUNT(*) 
FROM database_sales.sales
WHERE Country = 'Canada'
    AND Ship_Date BETWEEN '2022-01-01' AND '2022-01-07';
SET @end = UNIX_TIMESTAMP(NOW(6));
SET @total_time_large = @end - @start;
 
-- Show results
SELECT 
    @total_time_small AS small_dataset_seconds,
    @total_time_medium AS medium_dataset_seconds,
    @total_time_large AS large_dataset_seconds;

