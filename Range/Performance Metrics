-- Throughput
-- Partitioned
DELIMITER $$

CREATE PROCEDURE test_range_partitioned(IN runs INT)
BEGIN
    DECLARE i INT DEFAULT 0;
    DECLARE start_time DOUBLE;
    DECLARE end_time DOUBLE;
    DECLARE total_time DOUBLE;
    DECLARE dummy INT;

    -- Start time with microseconds
    SET start_time = UNIX_TIMESTAMP(NOW(6));

    -- Loop to run the query multiple times
    WHILE i < runs DO
        -- Use INTO @dummy to avoid returning rows
        SELECT COUNT(*) INTO dummy 
        FROM sales_range
        WHERE region='Europe' 
          AND order_date = '2024-01-01';
        SET i = i + 1;
    END WHILE;

    -- End time with microseconds
    SET end_time = UNIX_TIMESTAMP(NOW(6));

    -- Total elapsed time in seconds (decimal)
    SET total_time = end_time - start_time;

    -- Show only QPS result
    SELECT runs / total_time AS queries_per_second;
END$$

DELIMITER ;

-- Run for 10 queries
CALL test_range_partitioned(10);

