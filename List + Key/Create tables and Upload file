CREATE TABLE sales_list_key_partitioned (
    id BIGINT NOT NULL AUTO_INCREMENT,
    Region VARCHAR(255),
    Country VARCHAR(255),
    Item_Type_ID TINYINT NOT NULL,
    Item_Type VARCHAR(255) NOT NULL,
    Sales_Channel VARCHAR(255),
    Order_Priority CHAR(1),
    Order_Date DATE,
    Order_ID BIGINT,
    Ship_Date DATE,
    Units_Sold INT,
    Unit_Price DECIMAL(10,2),
    Unit_Cost DECIMAL(10,2),
    Total_Revenue DECIMAL(15,2),
    Total_Cost DECIMAL(15,2),
    Total_Profit DECIMAL(15,2),
    PRIMARY KEY (id, Order_ID, Item_Type_ID, Order_Priority)
)
PARTITION BY LIST(Item_Type_ID)
SUBPARTITION BY KEY(Order_Priority)
SUBPARTITIONS 4
(
    PARTITION p1 VALUES IN (1),
    PARTITION p2 VALUES IN (2),
    PARTITION p3 VALUES IN (3),
    PARTITION p4 VALUES IN (4),
    PARTITION p5 VALUES IN (5),
    PARTITION p6 VALUES IN (6),
    PARTITION p7 VALUES IN (7),
    PARTITION p8 VALUES IN (8),
    PARTITION p9 VALUES IN (9),
    PARTITION p10 VALUES IN (10),
    PARTITION p11 VALUES IN (11),
    PARTITION p12 VALUES IN (12)
);

LOAD DATA INFILE 'C:/ProgramData/MySQL/MySQL Server 8.0/Uploads/sales_2021_2024.csv'
INTO TABLE sales_list_key_partitioned
FIELDS TERMINATED BY ','
ENCLOSED BY '"'
LINES TERMINATED BY '\n'
IGNORE 1 ROWS
(
    Region,
    Country,
    @Item_Type_Str,
    Sales_Channel,
    Order_Priority,
    @Order_Date,
    Order_ID,
    @Ship_Date,
    Units_Sold,
    Unit_Price,
    Unit_Cost,
    Total_Revenue,
    Total_Cost,
    Total_Profit
)
SET
    Item_Type_ID = CASE @Item_Type_Str
        WHEN 'Cereal' THEN 1
        WHEN 'Baby Food' THEN 2
        WHEN 'Fruits' THEN 3
        WHEN 'Snacks' THEN 4
        WHEN 'Personal Care' THEN 5
        WHEN 'Beverages' THEN 6
        WHEN 'Office Supplies' THEN 7
        WHEN 'Cosmetics' THEN 8
        WHEN 'Clothes' THEN 9
        WHEN 'Vegetables' THEN 10
        WHEN 'Household' THEN 11
        WHEN 'Meat' THEN 12
        ELSE NULL   -- rejects unknown types
    END,
    Item_Type = @Item_Type_Str,
    Order_Date = STR_TO_DATE(@Order_Date, '%Y-%m-%d'),
    Ship_Date = STR_TO_DATE(@Ship_Date, '%Y-%m-%d');

-- to view partitions of the table
SELECT 
    PARTITION_NAME,
    SUBPARTITION_NAME,
    PARTITION_ORDINAL_POSITION,
    TABLE_ROWS
FROM information_schema.PARTITIONS
WHERE TABLE_SCHEMA = 'sales_database'
  AND TABLE_NAME = 'sales_list_key_partitioned'
ORDER BY PARTITION_ORDINAL_POSITION;

-- To see how many rows exist for each order priority in each item type 
SELECT Item_Type, Order_Priority, COUNT(*) AS Num_Rows
FROM sales_list_key_partitioned
GROUP BY Item_Type, Order_Priority
ORDER BY Item_Type, Order_Priority;

