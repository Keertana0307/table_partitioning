-- Query Execution Time
-- Partitioned
-- Initialize total time
SET @total_time = 0;

-- Run 1
SET @start = UNIX_TIMESTAMP(NOW(6));
SELECT YEAR(Order_Date) AS order_year, Region, SUM(Total_Revenue) AS total_revenue
FROM sales_range_hash_partitioned
where region_id = 1
GROUP BY order_year, Region;
SET @end = UNIX_TIMESTAMP(NOW(6));
SET @total_time = @total_time + (@end - @start);

