-- Scalability Test
-- Partitioned table (LIST)
-- Initialize total time for averaging
SET @total_time_small = 0;
SET @total_time_medium = 0;
SET @total_time_large = 0;

-- Small dataset: 1 week of orders
SET @start = UNIX_TIMESTAMP(NOW(6));
SELECT * 
FROM sales_list_partition
WHERE region='EUROPE' AND order_date BETWEEN '2023-01-01' AND '2023-01-07';
SET @end = UNIX_TIMESTAMP(NOW(6));
SET @total_time_small = @total_time_small + (@end - @start);

-- Medium dataset: 1 month of orders
SET @start = UNIX_TIMESTAMP(NOW(6));
SELECT * 
FROM sales_list_partition
WHERE region='EUROPE' AND order_date BETWEEN '2023-01-01' AND '2023-01-31';
SET @end = UNIX_TIMESTAMP(NOW(6));
SET @total_time_medium = @total_time_medium + (@end - @start);

-- Large dataset: full year
SET @start = UNIX_TIMESTAMP(NOW(6));
SELECT * 
FROM sales_list_partition
WHERE region='EUROPE' AND order_date BETWEEN '2023-01-01' AND '2023-12-31';
SET @end = UNIX_TIMESTAMP(NOW(6));
SET @total_time_large = @total_time_large + (@end - @start);

-- Display results for partitioned table
SELECT 
    @total_time_small AS partitioned_small_seconds,
    @total_time_medium AS partitioned_medium_seconds,
    @total_time_large AS partitioned_large_seconds;


