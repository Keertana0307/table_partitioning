CREATE TABLE sales_list (
    id BIGINT NOT NULL AUTO_INCREMENT,
    Region VARCHAR(255),
    Country VARCHAR(255),
    Item_Type VARCHAR(255),
    Sales_Channel VARCHAR(255),
    Order_Priority CHAR(1),
    Order_Date DATE,
    Order_ID BIGINT,
    Ship_Date DATE,
    Units_Sold INT,
    Unit_Price DECIMAL(10,2),
    Unit_Cost DECIMAL(10,2),
    Total_Revenue DECIMAL(15,2),
    Total_Cost DECIMAL(15,2),
    Total_Profit DECIMAL(15,2),
    PRIMARY KEY (id, Region)
)
PARTITION BY LIST COLUMNS (Region) (
    PARTITION p_asia VALUES IN ('Asia'),
    PARTITION p_europe VALUES IN ('Europe'),
    PARTITION p_ssa VALUES IN ('Sub-Saharan Africa'),
    PARTITION p_mena VALUES IN ('Middle East and North Africa'),
    PARTITION p_ausoc VALUES IN ('Australia and Oceania'),
    PARTITION p_cac VALUES IN ('Central America and the Caribbean'),
    PARTITION p_na VALUES IN ('North America')
);
