# Using Google Collab
# Scalability Comparison
# Hash Partitioning
import matplotlib.pyplot as plt

# Dataset sizes
datasets = ['Small', 'Medium', 'Large']

# Execution times or metric
partitioned = [1.348235, 1.180255, 1.332584]
non_partitioned = [2.108305, 1.898255, 1.550055]

# Plot the lines
plt.plot(datasets, partitioned, marker='o', label='Partitioned')
plt.plot(datasets, non_partitioned, marker='o', label='Non-partitioned')

# Add titles and labels
plt.title('Scalability Comparison of Hash Partitioning')
plt.xlabel('Dataset Size')
plt.ylabel('Query Execution Time (second)')
plt.grid(True)
plt.legend()

# Show the plot
plt.show()


